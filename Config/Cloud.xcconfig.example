// Signed builds: copy to Config/Local.xcconfig (git-ignored), fill in the placeholders. Both Debug and Release
// already include it through Config/App.xcconfig. The default build stays unsigned and capability-free.
PRODUCT_BUNDLE_IDENTIFIER = com.yourcompany.RoamReady
DEVELOPMENT_TEAM = YOURTEAMID
ROAMREADY_MIRRORING_CONTAINER = iCloud.com.yourcompany.RoamReady
CODE_SIGN_ENTITLEMENTS = Config/Cloud.entitlements

// Config/Cloud.entitlements enables CloudKit (this container) and WeatherKit. On the App ID, enable
// iCloud (CloudKit), Push Notifications, and WeatherKit; Xcode signing supplies aps-environment.
// CloudKit uses the device's iCloud account; the app has no accounts of its own.
