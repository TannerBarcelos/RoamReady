// Apply to BOTH build configurations after registering your App ID and iCloud container.
// Replace placeholders, then use a configuration stored outside public source if desired.
PRODUCT_BUNDLE_IDENTIFIER = com.yourcompany.RoamReady
DEVELOPMENT_TEAM = YOURTEAMID
ROAMREADY_MIRRORING_CONTAINER = iCloud.com.yourcompany.RoamReadyManaged
CODE_SIGN_ENTITLEMENTS = Config/Cloud.entitlements
// CloudKit uses the device's iCloud account; the app has no accounts of its own.

// Use a dedicated container for Core Data mirroring.
// Enable Push Notifications for this App ID; Xcode signing supplies aps-environment.
