{
  "name": "roamready-worker",
  "private": true,
  "type": "module",
  "description": "RoamReady's Cloudflare Worker. Not deployed in v1; starting point for v2 server work (#34).",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test --experimental-strip-types 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261007.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
