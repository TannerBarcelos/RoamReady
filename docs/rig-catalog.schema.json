{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roam Ready rig catalog v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "coverageNote",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "coverageNote": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "make",
          "model",
          "sourceURL",
          "imageRights",
          "year",
          "floorplan",
          "rigType",
          "imageURL"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "make": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "sourceURL": {
            "type": "string",
            "minLength": 1,
            "format": "uri",
            "pattern": "^https://"
          },
          "imageRights": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "floorplan": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "rigType": {
            "enum": [
              "travelTrailer",
              "fifthWheel",
              "motorhome",
              "camperVan",
              "truckCamper",
              "popUp",
              "carCamping",
              "tent"
            ]
          },
          "imageURL": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "pattern": "^https://"
          },
          "imageLicense": {
            "type": "object",
            "required": [
              "approvalStatus",
              "licenseURL",
              "rightsHolder",
              "permitsOfflineRedistribution"
            ],
            "additionalProperties": false,
            "properties": {
              "approvalStatus": {
                "const": "approved"
              },
              "licenseURL": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "rightsHolder": {
                "type": "string",
                "minLength": 1
              },
              "permitsOfflineRedistribution": {
                "const": true
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "imageURL": {
                  "type": "string"
                }
              },
              "required": [
                "imageURL"
              ]
            },
            "then": {
              "required": [
                "imageLicense"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "imageLicense"
                ]
              }
            }
          }
        ]
      },
      "minItems": 1
    }
  }
}
